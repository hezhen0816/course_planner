VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SCHOOL_CREDENTIALS_ENCRYPTION_SECRET=replace-with-openssl-rand-hex-32
NTUST_VERIFY_SSL=true

# --- monitor worker (backend/monitor) ---
# Fernet key for user_settings secrets; rotate with scripts/monitor/rotate_encryption_key.py
ENCRYPTION_KEY=
# 預設學期（留空則抓官方最新）
NTUST_SEMESTER=
# 加選回應日誌保留天數（0 表示不自動清理）
NTUST_ENROLLMENT_LOG_RETENTION_DAYS=7
